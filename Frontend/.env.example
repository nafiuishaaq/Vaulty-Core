# Stellar Network Configuration
NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# Backend API Configuration
# Note: This must point to the actual backend which runs on port 3000
# and exposes /api/v1/ routes.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Wallet Configuration
NEXT_PUBLIC_WALLET_NETWORK=testnet

# Feature Flags
NEXT_PUBLIC_ENABLE_LENDING=false
NEXT_PUBLIC_ENABLE_BORROWING=false
NEXT_PUBLIC_ENABLE_INVESTMENTS=false

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
